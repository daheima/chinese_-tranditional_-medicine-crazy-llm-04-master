{
  "entities": [
    {
      "name": "增损乐令汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治诸虚不足，小腹急痛，胁肋腆胀，脐下虚满，胸中烦悸，面色萎黄，唇干口燥，手足逆冷，体常自汗，腰背强急，骨肉酸疼，咳嗽喘乏，不能饮食",
        "taboo": null,
        "usage": "每服12克，用水400毫升，加生姜5片，大枣2个，煎至280毫升，去滓，空腹时服。腹满食少，去枣；下焦虚冷，不甚沿，小便数者，倍人参、当归、附子；烦渴引饮，加栝楼根；遗泄、白浊，加龙骨、白蔹；小便急，引心痛者，加干姜"
      }
    },
