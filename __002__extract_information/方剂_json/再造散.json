  "entities": [
    {
      "name": "再造散",
      "type": "Formula",
      "attributes": {
        "effect": "补气助阳，疏风散寒，解表祛邪，佐制合营，温胃滋脾，升腾脾胃生发之气，调营卫而资汗源",
        "indication": "阳气虚弱，外感风寒。恶寒发热，热轻寒重，无汗肢冷，倦怠嗜卧，面色苍白，语言低微，舌淡苔白，脉沉无力，或浮大无力"
      }
    },
