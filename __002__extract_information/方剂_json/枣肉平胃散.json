{
  "entities": [
    {
      "name": "枣肉平胃散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "调气暖胃，化宿食，消痰饮，辟风、寒、冷、湿四时非节之气",
        "indication": "脾胃不和，不思饮食，心腹、胁肋胀满刺痛，口苦无味，胸满短气，呕哕恶心，噫气吞酸，面色萎黄，肌体瘦弱，怠惰嗜卧，体重节痛，常多自利，或发霍乱；及五噎八痞，膈气反胃",
        "usage": "每服二钱，用盐汤点，空心，食前"
      }
    },
