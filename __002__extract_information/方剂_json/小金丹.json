    {
      "name": "小金丹",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "流注、痰核、瘰疬、乳岩、横痃、贴骨疽、鳝拱头等",
        "taboo": null,
        "usage": "每日取药一粒，研碎，浸化在一小杯酒中，1-2小时后陈酒送下，欲醉为好。其后盖被睡卧，以求汗出。病重而久者，可早晚各用一粒。其病在身体上部者易晚睡前用之；其病在体下部者易空腹用之。另外，其药丸可捣碎同时外用。"
      }
