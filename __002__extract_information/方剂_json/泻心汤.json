{
  "entities": [
    {
      "name": "泻心汤",
      "type": "Formula",
      "attributes": {
        "alias": "大黄黄连泻心汤、三黄汤、三黄泻心汤",
        "effect": "泻火解毒，清热燥湿",
        "indication": "邪火内炽，迫血妄行，吐血，衄血，便秘溲赤；或湿热内蕴而成黄疸，胸痞烦热；三焦积热，眼目赤肿，口舌生疮，外证疮疡，心胸烦闷，大便秘绪；湿热黄疸，胸中烦热痞满，舌苔黄腻，脉数实者。",
        "usage": "上药三味，以水800毫升，煮取250毫升，顿服之。"
      }
    },
